DATABASE_URL=postgres://attendance:attendance@localhost:5434/attendance
TEST_DATABASE_URL=postgres://attendance:attendance@localhost:5434/attendance_test
# Set to "true" behind HTTPS in production so session cookies are Secure-only.
COOKIE_SECURE=false
APP_TIMEZONE=Europe/Dublin
# Encrypts worker IBANs (any random string of 32+ characters). Keep it safe: IBANs are unreadable without it.
BANK_DATA_KEY=change-me-to-a-long-random-secret-of-32-plus-chars
